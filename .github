name: Expiry push

on:
  schedule:
    - cron: '0 7 * * *'   # каждый день в 07:00 UTC (09:00 летом / 08:00 зимой в Нидерландах)
  workflow_dispatch:       # можно запустить вручную: вкладка Actions → Run workflow

permissions:
  contents: read

jobs:
  notify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: npm install --omit=dev --no-audit --no-fund
      - run: node scripts/notify.mjs
        env:
          FIREBASE_SERVICE_ACCOUNT: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}
